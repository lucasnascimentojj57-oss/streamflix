# ─────────────────────────────────────────────────────────────
# TMDB — API Read Access Token (v4)
# ─────────────────────────────────────────────────────────────
# Como obter (2 minutos):
#   1. Crie uma conta em https://www.themoviedb.org/signup
#   2. Confirme o e-mail
#   3. Acesse https://www.themoviedb.org/settings/api
#   4. Clique em "Create" → escolha "Developer" → aceite os termos
#   5. Preencha o formulário (pode usar "Educational/Personal" como finalidade)
#   6. Copie o valor do campo "API Read Access Token" (um JWT longo, começa com "eyJ...")
#
# IMPORTANTE: use o *Read Access Token (v4)*, NÃO a "API Key (v3)".
# Esta variável NÃO tem prefixo NEXT_PUBLIC_, portanto nunca é enviada ao browser.

TMDB_ACCESS_TOKEN=cole_seu_read_access_token_aqui

# ─────────────────────────────────────────────────────────────
# TMDB — alternativa: API Key (v3)
# ─────────────────────────────────────────────────────────────
# Opcional. Só é usada se TMDB_ACCESS_TOKEN estiver vazio.
#
# Diferença: a v3 é uma string de 32 caracteres hexadecimais (ex.:
# "f5c61f18dc8e19ee5571e3d182a05255") e a API a exige na URL, não no
# header. A v4 é preferível porque o segredo não fica na URL —
# portanto não vaza em logs, histórico ou mensagens de erro.
#
# Use isto apenas se você já tiver a v3 em mãos e não quiser gerar a v4.

# TMDB_API_KEY=cole_sua_api_key_v3_aqui

# Região e idioma usados nas consultas de disponibilidade de streaming.
NEXT_PUBLIC_TMDB_REGION=BR
NEXT_PUBLIC_TMDB_LANGUAGE=pt-BR

# ─────────────────────────────────────────────────────────────
# Supabase — NECESSÁRIO para as listas pessoais
# ─────────────────────────────────────────────────────────────
# As listas (quero assistir / já assisti) exigem conta. Sem estas
# variáveis, o catálogo funciona normalmente mas as áreas de lista
# mostram um aviso explicando como configurar — não há modo convidado.
#
# Como obter:
#   1. Crie um projeto em https://supabase.com/dashboard
#   2. Rode o conteúdo de supabase/schema.sql no SQL Editor
#   3. Vá em Project Settings → API
#   4. Copie "Project URL" e a chave "anon public"
#
# Para permitir cadastro sem confirmação de e-mail (recomendado nesta fase):
#   Authentication → Sign In / Providers → Email → desligue "Confirm email".
#
# A anon key é PÚBLICA por design — ela vai no bundle do browser.
# A segurança vem das políticas de Row Level Security (ver schema.sql).
#
# ATENÇÃO: a anon key é um JWT longo (200+ caracteres, começa com "eyJ").
# Se ela estiver curta como um placeholder, o login não vai funcionar.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
